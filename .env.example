# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SHOPIFY SUBSCRIPTION INTEGRATION CONFIGURATION
# ==============================================================================
# 1. SHOPIFY_STORE_DOMAIN: Your Shopify store domain (e.g. your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=""

# 2. SHOPIFY_API_KEY: Shopify Custom App Client ID / API Key
SHOPIFY_API_KEY=""

# 3. SHOPIFY_API_SECRET: Shopify Custom App Client Secret (Starts with shpss_)
# Also automatically used by the server to verify incoming webhook HMAC-SHA256 signatures
SHOPIFY_API_SECRET=""

# 4. SHOPIFY_STOREFRONT_ACCESS_TOKEN: Storefront API Access Token
# Generated in Shopify Admin -> Settings -> Apps and sales channels -> Develop apps -> Configure Storefront API
# Required Storefront API scopes: unauthenticated_read_product_listings, unauthenticated_write_checkouts, unauthenticated_read_checkouts
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# 5. SHOPIFY_PRODUCT_VARIANT_ID: Product Variant GID for Life Reset Premium ($9.99 USD)
SHOPIFY_PRODUCT_VARIANT_ID="gid://shopify/ProductVariant/67632091955475"

# 6. SHOPIFY_SUBSCRIPTION_PLAN_ID: Selling Plan GID for $9.99 USD/month recurring subscription
SHOPIFY_SUBSCRIPTION_PLAN_ID="gid://shopify/SellingPlan/692445053203"

# 7. SHOPIFY_WEBHOOK_SECRET: Shopify Webhook signature secret from Shopify Admin -> Settings -> Notifications -> Webhooks
SHOPIFY_WEBHOOK_SECRET=""

# 8. SHOPIFY_WEBHOOK_SERVICE_URL: Dedicated Google Cloud Run webhook service URL (e.g. https://life-reset-webhook-xyz-uc.a.run.app)
SHOPIFY_WEBHOOK_SERVICE_URL=""

# 9. INTERNAL_SERVICE_KEY: (Optional) Pre-shared secret to authenticate internal audit calls between app backend and webhook service
INTERNAL_SERVICE_KEY=""

# 10. SHOPIFY_ADMIN_ACCESS_TOKEN: (Optional) Custom App Admin API token for direct server-side contract lookups
# Admin API scopes: read_own_subscription_contracts, write_own_subscription_contracts, read_orders
SHOPIFY_ADMIN_ACCESS_TOKEN=""

# 11. SUBSCRIPTION_BINDING_SECRET: (Recommended) Server-only HMAC-SHA256 secret used to sign customerBindingProof
# Falls back to SHOPIFY_API_SECRET if not explicitly set.
SUBSCRIPTION_BINDING_SECRET=""

